++++ b/src/common/linux/dump_symbols.cc
+@@ -111,6 +111,10 @@ using google_breakpad::wasteful_vector;
+ #define EM_AARCH64      183
+ #endif
+ 
++#ifdef EM_LOONGARCH
++#define EM_LOONGARCH    258
++#endif
++
