FROM linuxdeepin/deepin:crimson-loong64-v1.6.0

# Chromium 148 / Electron 42.3.0
ARG GN_REVISION="6e8dcdebbadf4f8aa75e6a4b6e0bdf89dce1513a"

ENV DEBIAN_FRONTEND=noninteractive
RUN echo 'deb https://mirrors.ustc.edu.cn/deepin/beige crimson main commercial community' > /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        clang-18 \
        python3 \
        ninja-build && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-18 100 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-18 100

WORKDIR /root
RUN git clone https://gn.googlesource.com/gn && \
    cd gn && \
    git checkout ${GN_REVISION} && \
    python3 build/gen.py && \
    ninja -C out && \
    tar czf /root/gn.tar.gz -C out gn
