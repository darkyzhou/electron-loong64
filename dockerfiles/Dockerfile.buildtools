FROM linuxdeepin/deepin:crimson-loong64-v1.6.0

RUN groupadd --gid 1000 builduser && \
    useradd --uid 1000 --gid builduser --shell /bin/bash --create-home builduser

ENV DEBIAN_FRONTEND=noninteractive
RUN echo 'deb https://mirrors.ustc.edu.cn/deepin/beige crimson main commercial community' > /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        sudo \
        xz-utils \
        nano \
        fish \
        patch \
        jq \
        python3 \
        python3-certifi \
        python3-google-auth \
        python3-httplib2 \
        python3-oauth2client \
        python3-requests \
        python3-six \
        build-essential \
        clang && \
    rm -rf /var/lib/apt/lists/*

ARG NODEJS_VERSION=24.15.0
RUN curl -fsSL "https://unofficial-builds.nodejs.org/download/release/v${NODEJS_VERSION}/node-v${NODEJS_VERSION}-linux-loong64.tar.xz" \
        -o /tmp/node.tar.xz && \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
    rm /tmp/node.tar.xz && \
    npm install -g npm@latest node-gyp yarn

RUN echo 'builduser ALL=NOPASSWD: ALL' >> /etc/sudoers.d/50-builduser

USER builduser
WORKDIR /home/builduser
RUN npm install @electron/build-tools
